# =========================================================================
# API Gestion Chantier — Variables d'environnement
# 
# Instructions :
# 1. Copiez ce fichier sous le nom .env :
#    cp .env.example .env
# 2. Remplissez au minimum DJANGO_SECRET_KEY et POSTGRES_PASSWORD.
# =========================================================================

# ---- Sécurité & Mode Django ----------------------------------------------
# Pour générer une clé secrète sous Windows ou Linux :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cle-secrete-a-remplacer-par-la-votre
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
# En production sur cPanel, ajoutez vos domaines :
# DJANGO_ALLOWED_HOSTS=api-chantier.soumafe.com,.soumafe.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
LOG_LEVEL=INFO

# ---- Base de données PostgreSQL -----------------------------------------
# Option A : Local (Docker ou PostgreSQL 16 local) :
POSTGRES_DB=ccd_digital
POSTGRES_USER=ccd
POSTGRES_PASSWORD=ccd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Option B : Production cPanel local (PostgreSQL 13.23+ hébergé sur cPanel) :
# POSTGRES_DB=votre_compte_nom_base
# POSTGRES_USER=votre_compte_nom_user
# POSTGRES_PASSWORD=votre_mot_de_passe_bdd_cpanel
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# Option C : Base managée externe (Supabase PostgreSQL 17, pooler IPv4) :
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.VOTRE_REF_PROJET
# POSTGRES_PASSWORD=votre-mot-de-passe
# POSTGRES_HOST=aws-1-eu-west-3.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=0

# ---- Redis & Celery -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True exécute les tâches immédiatement en synchrone (utile si Redis n'est pas lancé) :
CELERY_TASK_ALWAYS_EAGER=True

# ---- Affichage & Fuseau horaire ------------------------------------------
FUSEAU_AFFICHAGE=Africa/Abidjan

# ---- Frontend & CORS ----------------------------------------------------
# FRONTEND_URL=https://soumafe.com
# CORS_ALLOWED_ORIGINS=https://soumafe.com,https://www.soumafe.com,http://localhost:3000
# True autorise explicitement tous les fronts (déconseillé si inutile).
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Configuration Emails (SMTP / Gmail / Mailpit) -----------------------
# EMAIL_BACKEND : django.core.mail.backends.smtp.EmailBackend (envoi réel)
#                 django.core.mail.backends.console.EmailBackend (affichage console)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Mettre à False sur Windows si un antivirus (ex: Avast) intercepte le trafic SSL/TLS en local :
EMAIL_SSL_CERT_VERIFY=True

# Identifiants SMTP (supporte indifféremment SYSTEM_SMTP_USER/PASS ou EMAIL_HOST_USER/PASSWORD) :
SYSTEM_SMTP_USER=votre_adresse@gmail.com
SYSTEM_SMTP_PASS=votre_mot_de_passe_application
# EMAIL_HOST_USER=votre_adresse@gmail.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_application

DEFAULT_FROM_EMAIL="CCD Digital <votre_adresse@gmail.com>"
EMAIL_COMMERCIAL=contact@votredomaine.ci

# Mode attrape-mail local (Mailpit) en développement :
# À True, redirige vers Mailpit (http://localhost:8025)
EMAIL_MAILPIT=False
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# ---- Passerelle de Paiement (CinetPay - Mode Test / Prod) ----------------
# Laisser vide pour utiliser le mode simulation local automatique.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=http://localhost:3000/abonnements/statut
# Endpoints par défaut (v2) :
# CINETPAY_CHECKOUT_URL=https://api-checkout.cinetpay.com/v2/payment
# CINETPAY_CHECK_URL=https://api-checkout.cinetpay.com/v2/payment/check
